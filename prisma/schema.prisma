// Supabase provides the Postgres instance + auth.users table.
// We key our rows to the Supabase auth user id (uuid stored as text).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id        String   @id @default(cuid())
  userId    String   // owner (supabase auth uid)
  name      String
  city      String?
  tier      Tier     @default(MID)
  createdAt DateTime @default(now())

  @@index([userId])
}

enum Tier {
  MID
  CONSULTANCY
  LARGE
}

model Contact {
  id                  String           @id @default(cuid())
  userId              String
  name                String
  company             String
  category            Category         @default(UNKNOWN)
  secondaryCategories String[]
  stage               Stage            @default(CONTACTED)
  connectionState     ConnectionState  @default(UNKNOWN_STATE)
  messageMode         MessageMode?
  linkedinUrl         String?
  profileText         String?          @db.Text
  rawProfileText      String?          @db.Text
  vendorEmail         String?
  nextStep            String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  messages            Message[]

  @@index([userId])
  @@index([userId, stage])
}

enum Category {
  RECRUITER_EMBEDDED
  RECRUITER_AGENCY
  RECRUITER_VENDOR
  ALUMNI
  STACK_MATCH
  HIRING_MANAGER
  UNKNOWN
}

enum ConnectionState {
  CONNECTED
  NOT_CONNECTED
  UNKNOWN_STATE
}

enum MessageMode {
  CONNECTION_NOTE
  FIRST_DM
}

enum Stage {
  REQUESTED
  CONTACTED
  REPLIED
  TALKING
  CLOSED
}

model Message {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role      Role     // YOU or THEM
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([contactId])
}

enum Role {
  YOU
  THEM
}

model Profile {
  id              String    @id @default(cuid())
  userId          String    @unique
  name            String
  role            String
  location        String
  stack           String
  experience      String
  education       String
  summary         String?   @db.Text
  cvFileUrl       String?
  cvFileName      String?
  cvUploadedAt    DateTime?
  workAuth        String?
  availability    String?
  openToContract  Boolean   @default(false)
  openToRelocation Boolean  @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}
